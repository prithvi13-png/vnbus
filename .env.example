# Application
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
APP_NAME="Vriddhi Nexus Bus"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
REQUEST_BODY_LIMIT=1mb
MAINTENANCE_MODE=false
NEXT_PUBLIC_MAINTENANCE_MODE=false
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://vnbus:vnbus@localhost:5432/vnbus?schema=public

# Redis, locks, rate limits, cache, and BullMQ
REDIS_URL=redis://localhost:6379
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=300
RATE_LIMIT_ADMIN_PER_MINUTE=120

# JWT and cookies
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Email
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@vriddhinexus.example
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# S3-ready storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloudflare
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Supplier adapters. Keep mock until real credentials are stored in a secret manager.
SUPPLIER_MODE=mock
SUPPLIER_PRIORITY=MOCK,BCI,ABHIBUS,REDBUS,TBO,CUSTOM
SUPPLIER_CONNECTION_TIMEOUT_MS=1500
SUPPLIER_REQUEST_TIMEOUT_MS=3000
SUPPLIER_RETRY_COUNT=1
SUPPLIER_RETRY_DELAY_MS=150
SUPPLIER_CIRCUIT_BREAKER_THRESHOLD=3
SUPPLIER_CIRCUIT_BREAKER_COOLDOWN_MS=30000
BCI_API_URL=
BCI_API_KEY=
REDBUS_API_URL=
REDBUS_API_KEY=
ABHIBUS_API_URL=
ABHIBUS_API_KEY=
TBO_API_URL=
TBO_API_KEY=
CUSTOM_BUS_API_URL=
CUSTOM_BUS_API_KEY=

# Payment adapters. Keep MOCK until gateway onboarding is complete.
PAYMENT_PROVIDER=MOCK
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
RAZORPAY_API_URL=
RAZORPAY_API_KEY=
CASHFREE_API_URL=
CASHFREE_API_KEY=
PHONEPE_API_URL=
PHONEPE_API_KEY=
STRIPE_API_URL=
STRIPE_API_KEY=
CUSTOM_PAYMENT_API_URL=
CUSTOM_PAYMENT_API_KEY=

# AI
AI_PROVIDER=none
AI_API_KEY=

# Monitoring
MONITORING_PROVIDER=prometheus
PROMETHEUS_ENABLED=true
SENTRY_DSN=
LOG_LEVEL=info

# Security
SECURITY_HEADERS_ENABLED=true
