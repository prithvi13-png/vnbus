{
  "name": "@vnbus/supplier-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/verify-dist.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "import:city-codes": "node scripts/import-city-codes.mjs"
  },
  "dependencies": {
    "@vnbus/shared": "workspace:*",
    "@vnbus/types": "workspace:*"
  }
}
